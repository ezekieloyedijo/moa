    "@vercel/blob": "1.1.1",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "zod": "^3.25.76",
