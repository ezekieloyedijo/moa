# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development, and add the
# same variables in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ───────────────────────────────
# POOLED connection string. In the Neon console → Connect, keep
# "Connection pooling" ON. The host contains "-pooler".
# Used by the app at runtime (dashboard saves, contact form, builds).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DIRECT (unpooled) connection string. Same as above but with
# "Connection pooling" OFF (no "-pooler" in the host).
# Used ONLY by `prisma migrate` (migrations need a direct connection).
# The Vercel Neon integration adds both DATABASE_URL and this one automatically.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── File storage (Vercel Blob) — images only, never videos ──
# Vercel → Storage → Create → Blob → connect to the project.
# Vercel adds this automatically; copy it here for local dev.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ── Auth (Auth.js / NextAuth v5) ─────────────────────────────
# Random secret used to sign session cookies. Generate one with:
#   npx auth secret      (or)      openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# The single owner account's login email.
ADMIN_EMAIL="mercy@example.com"

# Option A (recommended for local): plain password used ONLY by the
# seed script to create the admin user. Delete after seeding.
ADMIN_PASSWORD="change-me-to-something-strong"

# Option B (recommended for Vercel): a bcrypt hash of the password.
# Generate with:  npm run hash-password -- "your-password"
# If no admin user exists yet, the first successful login with
# ADMIN_EMAIL + this password creates the account automatically.
# NOTE: in a local .env file, escape every "$" as "\$".
ADMIN_PASSWORD_HASH=""

# ── Email notifications (optional, Resend free tier) ─────────
# When set, every new contact message is emailed to NOTIFY_EMAIL
# (falls back to ADMIN_EMAIL). Leave blank to disable.
RESEND_API_KEY=""
NOTIFY_EMAIL=""
# Sender address. "onboarding@resend.dev" works without a domain;
# after verifying your domain in Resend use e.g. "Portfolio <hello@yourdomain.com>".
RESEND_FROM="Portfolio <onboarding@resend.dev>"

# ── Site ─────────────────────────────────────────────────────
# The public URL (no trailing slash). Used for canonical URLs,
# sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
